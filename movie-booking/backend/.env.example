# Server Port
PORT=5000

# MongoDB Connection String (Supports both MONGODB_URI and MONGO_URI)
MONGO_URI=mongodb://127.0.0.1:27017/movie-booking
MONGODB_URI=mongodb://127.0.0.1:27017/movie-booking

# MongoDB Atlas (Cloud) Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/movie-booking?retryWrites=true&w=majority

# Client Origin (CORS) - Optional, default allows all or localhost
CLIENT_ORIGIN=http://localhost:5500
